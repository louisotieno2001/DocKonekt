<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacies</title>
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="stylesheet" href="/styles/small-devices.css">
    <link rel="icon" href="/res/Picture4.png" type="image/x-icon">
    <!-- SEO Meta Tags -->
    <meta name="description"
        content="Welcome to DocKonekt. Search for your hospital below or scroll down to pick a hospital.">
    <meta name="keywords" content="DocKonekt, hospital, health, search">
    <meta name="author" content="Futurion Labs">

    <!-- Open Graph Protocol for Social Media Sharing -->
    <meta property="og:title" content="DocKonekt">
    <meta property="og:description"
        content="Welcome to DocKonekt. Search for your hospital below or scroll down to pick a hospital.">
    <meta property="og:image" content="https://dockonekt.com/app/public/res/Picture4.png">
    <meta property="og:url" content="https://dockonekt.com">
    <meta property="og:type" content="website">

    <!-- Twitter Card for Twitter Sharing -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@louiso_chieng1">
    <meta name="twitter:title" content="DocKonekt">
    <meta name="twitter:description"
        content="Welcome to DocKonekt. Search for your hospital below or scroll down to pick a hospital.">
    <meta name="twitter:image" content="https://dockonekt.com/app/public/res/Picture4.png">
    <style>
        /* Add your CSS styling here */

        body {
            overflow-x: hidden;
            font-family: sans-serif;
            background-color: rgb(34, 36, 51);
        }

        .card {
            border: none;
            color: aliceblue;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 5px;
            width: 100%;
            background-color: rgb(34, 36, 51);
            box-sizing: border-box;
            box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
        }

        .button-9 {
            appearance: button;
            backface-visibility: hidden;
            background-color: rgb(26, 27, 37);
            border-radius: 6px;
            border-width: 0;
            box-shadow: rgba(50, 50, 93, .1) 0 0 0 1px inset, rgba(50, 50, 93, .1) 0 2px 5px 0, rgba(0, 0, 0, .07) 0 1px 1px 0;
            box-sizing: border-box;
            color: #fff;
            cursor: pointer;
            font-family: -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, sans-serif;
            font-size: 100%;
            height: 44px;
            line-height: 1.15;
            margin: 10px;
            outline: none;
            overflow: hidden;
            padding: 0 25px;
            position: relative;
            text-align: center;
            text-transform: none;
            transform: translateZ(0);
            transition: all .2s, box-shadow .08s ease-in;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            width: 75%;
        }

        .button-9:disabled {
            cursor: default;
        }

        .button-9:focus {
            box-shadow: rgba(50, 50, 93, .1) 0 0 0 1px inset, rgba(50, 50, 93, .2) 0 6px 15px 0, rgba(0, 0, 0, .1) 0 2px 2px 0, rgba(50, 151, 211, .3) 0 0 0 4px;
        }


        button {
            background-color: rgb(19, 20, 29);
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #proceed {
            margin-left: 80px;
        }

        #cancel {
            margin-left: 80px;
        }

        .booking {
            border-radius: 5px;
            /* height: 100vh; */
            background-color: rgb(34, 36, 51);
            margin-left: 10px;
            margin-right: 10px;
            margin-top: 5px;
            width: 98.5%;
            font-family: sans-serif;
        }

        .info-tab {
            width: 99.5%;
            padding: 5px;
            color: aliceblue;
            background-color: rgb(34, 36, 51);
            box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
        }

        .dialog a {
            color: aliceblue;
        }

        .dialog a:hover {
            color: rgb(18, 29, 117);
        }

        .option-txt {
            margin-left: 48px;
        }

        .user-info {
            border: none;
            color: aliceblue;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 5px;
            width: 100%;
            background-color: rgb(34, 36, 51);
            box-sizing: border-box;
            box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
        }

        #prescription {
            margin: 10px;
        }

        .preview {
            display: none;
            height: 200px;
            width: 250px;
            background-position: center;
            background-size: cover;
        }


        @media only screen and (max-width: 768px) {
            .info-tab {
                width: 95%;
                padding: 5px;
                color: aliceblue;
                background-color: rgb(34, 36, 51);
                box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
                margin-left: -3px;
            }

            .button-9{
                width: 50%;
            }

            .user-info {
                border: none;
                margin-left: -3px;
                color: aliceblue;
                padding: 10px;
                border-radius: 5px;
                margin-bottom: 5px;
                width: 98%;
                background-color: rgb(34, 36, 51);
                box-sizing: border-box;
                box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
            }

            .option-txt {
                margin-left: 0px;
            }

        }
    </style>
</head>

<body>
    <div class="top_bar">
        <img src="/res/Picture4.png" alt="logo" class="logo">
        <ul class="menu-items" id="menu-items">
            <li><a href="/home" title="Home page">Home</a></li>
            <li><a href="/blogs" title="Blogs page">Health Blog</a></li>
            <li><a href="/about" title="Learn more about us">About Us</a></li>
            <li><a href="/messages" title="Send uus a messaage">Contact Us</a></li>
            <li><a href="/terms" title="Look at our terms of service">Terms of service</a></li>
            <li><a href="/pharmacy/home" title="Register your pharmacy with us">Buy Medicine</a></li>
            <li><a href="/pharmacy/register" title="Register your pharmacy with us">Log in to pharmacy</a></li>
        </ul>
        <img src="/res/menu_icon.png" alt="menu_icon" class="menu_icon" id="menu_icon">
        <div class="profile" id="profile" style="background-image: url('/uploads/<%=  user.profile_pic %>');">
        </div>
    </div>
    <div class="blogtitle"></div>
    <div class="booking">
        <div class="pharmacy-container" id="pharmacy-container">
            <p class="info-tab">
                <span style="color: rgb(238, 58, 58);">NOTE:</span> It is important to contact the pharmacy you are
                ordering from to
                inquire if they have the medicine you are
                looking for before making your order. Dockonekt owns no pharmacies and therefore acts merely as a link
                between you and your preferred pharmacy.
            </p>
            <div class="pharmacy">
                <% users.forEach(user=> { %>
                    <% if (user.pharmacy_name && user.location) { %>
                        <div class="user-info">
                            <h2>
                                <%= user.pharmacy_name %>
                            </h2>
                            <p>
                                <%= user.location %>, <%= user.specific_location %>
                            </p>
                            <p>
                                <%= user.pharmacy_phone %>
                            </p>
                            <button class="order-btn" data-pharmacy-name="<%= user.pharmacy_name %>"
                                data-location="<%= user.location %>"
                                data-specific-location="<%= user.specific_location %>">
                                Order with <%= user.pharmacy_name %>
                            </button>
                        </div>
                        <% } %>
                            <% }); %>
            </div>

            <!-- Dialog box -->
            <dialog class="dialog" style="background-color: rgb(34, 36, 51); border: none; border-radius: 8px;">
                <!-- <h3 style="color: rgb(228, 82, 82);">Warning! This is an irreversible process, are you sure you want to
                    proceed?</h3> -->
                <form action="">
                    <button id="prescription">Add prescription picture</button>
                    <input type="file" id="fileInput" style="display: none;">
                    <div class="preview" id="preview">
                    </div>
                    <input type="hidden" name="pharmacy-name" id="pharmacy-name">
                    <input type="hidden" name="pharmacy-location" id="pharmacy-location">
                    <input type="hidden" name="data-specific-location" id="data-specific-location">
                    <input type="text" placeholder="Your location" id="user-location">
                    <input type="tel" placeholder="Your phone number" id="patient-phone"> <br>
                    <label for="option" class="option-txt">Do you agree to be contacted through this phone
                        number?</label> <br>
                    <input type="text" placeholder="Yes/No" id="agreement">
                </form>
                <button class="button-9" id="proceed">Proceed</button>
                <button class="button-9" id="cancel">Cancel</button>
                <p style="color: #fff; text-align: center;">By clicking proceed you agree to DocKonekt terms and conditions! <a
                        href="/terms">Terms of service</a></p>
            </dialog>

        </div>
        <div class="blogtitle">
        </div>
    </div>
    <div class="blogtitle"></div>
    <div class="bottom_bar">
        <footer class="footer">
            <center>
                <p>Follow us on social media below</p>
            </center>
            <div class="socials">
                <li class="socials_lin"><a href="https://www.linkedin.com/in/dockonekt-dcofficial-3892062bb/"
                        target="_blank"><img src="/res/linkedin.png" alt="LinkedIn"></a></li>
                <li class="socials_fb"><a href="https://www.facebook.com/profile.php?id=61551541325742"
                        target="_blank"><img src="/res/Facebook.png" alt="Facebook"></a></li>
                <li class="socials_ig"><a href="https://www.instagram.com/futurion_labs123/" target="_blank"><img
                            src="/res/Instagram.png" alt="Instagram"></a></li>
                <li class="socials_wa"><a href="https://wa.me/254746852485" target="_blank"><img
                            src="/res/icon-whatsapp.webp" alt="Whatsapp"></a></li>
                <li class="socials_tw"><a href="https://twitter.com/doconektoficial" target="_blank"><img
                            src="/res/x.jpg" alt="twitter"></a></li>
            </div>
            <p>Copyright&copy;2024 Made at <a href="https://futurionlab.com"> Futurion Labs</a>. All rights reserved</p>
        </footer>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const menuIcon = document.getElementById('menu_icon');
            const menuItems = document.getElementById('menu-items');
            const presBtn = document.getElementById('prescription');
            const previewDiv = document.getElementById('preview');

            menuIcon.addEventListener('click', function () {
                menuItems.classList.toggle('show');
            });

            const profile = document.getElementById('profile');

            profile.addEventListener('click', function (e) {
                window.location.href = '/profile';
            });

            // Dialog box and buttons
            const dialog = document.querySelector('.dialog');
            const proceedBtn = document.getElementById('proceed');
            const cancelBtn = document.getElementById('cancel');

            // Order buttons
            const orderButtons = document.querySelectorAll('.order-btn');
            orderButtons.forEach(button => {
                button.addEventListener('click', function () {
                    // Get pharmacy information from data attributes
                    const pharmacyName = this.getAttribute('data-pharmacy-name');
                    const location = this.getAttribute('data-location');
                    const specificLocation = this.getAttribute('data-specific-location');
                    // Set values in the dialog form fields
                    document.getElementById('pharmacy-name').value = pharmacyName;
                    document.getElementById('pharmacy-location').value = location;
                    document.getElementById('data-specific-location').value = specificLocation;

                    // Show the dialog box
                    dialog.showModal();
                });
            });

            // Proceed button click event
            proceedBtn.addEventListener('click', async function () {
                // Get values from the form fields
                const pharmacyName = document.getElementById('pharmacy-name').value;
                const pharmacyLocation = document.getElementById('pharmacy-location').value;
                const specificLocation = document.getElementById('data-specific-location').value;
                const userLocation = document.getElementById('user-location').value;
                const patientPhone = document.getElementById('patient-phone').value;
                const agreement = document.getElementById('agreement').value;

                if (!pharmacyLocation || !pharmacyName || !specificLocation || !patientPhone || !agreement) {
                    alert("An error occurred, make sure all fields are filled")
                }
                else {

                    // Get image file from file input
                    const selectedFile = fileInput.files[0];

                    // Prepare form data including the image file if available
                    const formData = new FormData();
                    formData.append('pharmacyName', pharmacyName);
                    formData.append('pharmacyLocation', pharmacyLocation);
                    formData.append('specificLocation', specificLocation);
                    formData.append('userLocation', userLocation);
                    formData.append('patientPhone', patientPhone);
                    formData.append('agreement', agreement);

                    if (selectedFile) {
                        formData.append('imageFile', selectedFile);
                    }

                    try {
                        // Send form data to server using fetch
                        const response = await fetch('/orders', {
                            method: 'POST',
                            body: formData // Use FormData for file upload
                        });

                        if (!response.ok) {
                            throw new Error('Failed to submit order.');
                        }

                        const data = await response.json();
                        // console.log('Order submitted successfully:', data);

                        alert('Order placed successfully');

                        dialog.close();

                    } catch (error) {
                        console.error('Error submitting order:', error.message);
                        // Handle error
                    }
                }
            });

            // Cancel button click event
            cancelBtn.addEventListener('click', async function () {
                dialog.close();
            });

            presBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                fileInput.click();
                previewDiv.style.display = 'block';
            });

            fileInput.addEventListener('change', (e) => {
                const selectedFile = e.target.files[0];
                if (selectedFile) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        previewDiv.style.backgroundImage = `url('${event.target.result}')`;
                    };
                    reader.readAsDataURL(selectedFile);
                }
            });
        });
    </script>


</body>

</html>